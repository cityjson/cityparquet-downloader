{
  "name": "cityparquet-downloader",
  "version": "0.0.0",
  "private": true,
  "description": "Download any area of a CityParquet package, in the browser.",
  "license": "MIT",
  "type": "module",
  "packageManager": "pnpm@12.21.0",
  "engines": {
    "node": ">=26"
  },
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview",
    "check": "biome ci . && tsc --noEmit",
    "test": "vitest run --project unit",
    "test:browser": "vitest run --project browser"
  },
  "dependencies": {
    "@cityjson/cjconv-core": "0.1.0",
    "@duckdb/duckdb-wasm": "1.33.1-dev118.0",
    "class-variance-authority": "0.7.1",
    "clsx": "2.1.1",
    "fflate": "0.8.2",
    "maplibre-gl": "6.18.0",
    "radix-ui": "1.8.1",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "tailwind-merge": "3.7.0",
    "zustand": "5.1.0"
  },
  "devDependencies": {
    "@biomejs/biome": "2.6.8",
    "@tailwindcss/vite": "4.3.5",
    "@types/node": "^26.6.6",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.3.0",
    "@vitest/browser-playwright": "^5.1.0",
    "playwright": "^1.65.1",
    "tailwindcss": "4.3.5",
    "tw-animate-css": "1.4.0",
    "typescript": "^7.0.2",
    "vite": "^8.3.8",
    "vitest": "^5.1.0"
  }
}
